# FinStream Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Kafka ──────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_CONSUMER_GROUP_ID=finstream-consumer-group

# ── MySQL ──────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=finstream
MYSQL_USERNAME=finstream_user
MYSQL_PASSWORD=change_me_before_use

# ── Producer (Python) ──────────────────────────────────────
PRODUCER_EVENT_COUNT=20
PRODUCER_INTERVAL_SECONDS=0.5

# ── Consumer (Spring Boot) ─────────────────────────────────
# Rule A: flag transactions above this INR amount
RULE_HIGH_VALUE_THRESHOLD=50000

# Rule C: flag account with >= this many transactions within window
RULE_RAPID_SPENDING_MIN_COUNT=3
RULE_RAPID_SPENDING_WINDOW_SECONDS=60
