# ==============================================================================
# FinStream Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# DO NOT COMMIT REAL CREDENTIALS.
# ==============================================================================

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_CONSUMER_GROUP=finstream-consumer-group

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=finstream
MYSQL_USER=finstream_user
MYSQL_PASSWORD=your_secure_password_here

# Monitoring Rule Thresholds
MONITORING_HIGH_VALUE_THRESHOLD=50000.00
MONITORING_RAPID_SPENDING_COUNT=3
MONITORING_RAPID_SPENDING_WINDOW_SECONDS=60
